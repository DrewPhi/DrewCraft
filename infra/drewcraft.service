[Unit]
Description=DrewCraft Minecraft Server
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=drewcraft
Group=drewcraft
WorkingDirectory=/srv/drewcraft
Environment=HOME=/srv/drewcraft
ExecStart=/srv/drewcraft/bin/start-server.sh
Restart=on-failure
RestartSec=10
TimeoutStopSec=120
KillSignal=SIGINT
SuccessExitStatus=0 130 143
LimitNOFILE=65535
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ReadWritePaths=/srv/drewcraft
ProtectHome=true

[Install]
WantedBy=multi-user.target
