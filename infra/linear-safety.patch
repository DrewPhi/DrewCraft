+    /** Offline maintenance mode: convert with Minecraft's real reader before any ticking. */
+    @SubscribeEvent
+    public void onConversionOnly(net.neoforged.neoforge.event.server.ServerAboutToStartEvent event) {
+        if (!Boolean.getBoolean("drewcraft.linear.convertOnly")) return;
+        java.nio.file.Path world = event.getServer().getWorldPath(net.minecraft.world.level.storage.LevelResource.ROOT);
+        try (var directories = java.nio.file.Files.walk(world)) {
+            for (var directory : directories.filter(java.nio.file.Files::isDirectory).sorted().toList()) {
+                String name = directory.getFileName().toString();
+                if (name.equals("region") || name.equals("entities") || name.equals("poi")) {
+                    com.memesgmm.linear.linear.MCAConverter.convertFolder(directory);
+                }
+            }
+            java.nio.file.Files.writeString(world.resolve(".linear-conversion-complete"), "verified-before-world-load\n");
+        } catch (java.io.IOException e) {
+            throw new IllegalStateException("Offline conversion failed; do not load world", e);
+        }
+        // Intentionally abort startup: loading/ticking would invalidate the byte comparison.
+        throw new IllegalStateException("DREWCRAFT_CONVERSION_ONLY_COMPLETE: expected maintenance shutdown before ticking");
+    }
+
