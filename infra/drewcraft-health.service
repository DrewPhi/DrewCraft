[Unit]
Description=DrewCraft release health endpoint
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=drewcraft
Group=drewcraft
ExecStart=/usr/bin/python3 /srv/drewcraft/bin/health_server.py --state-file /srv/drewcraft/state/health.json --bind 0.0.0.0 --port 25566
Restart=on-failure
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadOnlyPaths=/srv/drewcraft/state

[Install]
WantedBy=multi-user.target
