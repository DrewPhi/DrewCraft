[Unit]
Description=DrewCraft size-targeted Overworld pregeneration controller
After=drewcraft.service
Requires=drewcraft.service

[Service]
Type=simple
User=root
Group=root
ExecStart=/usr/bin/python3 /srv/drewcraft/bin/pregen_controller.py --baseline-bytes 5239550 --target-bytes 50000000000 --maximum-bytes 55000000000 --minimum-free-bytes 25000000000 --maximum-radius 1000000 --idle-grace-seconds 600 --generation-batch-blocks 1024 --dh-lag-blocks 512 --dh-maintenance-interval-seconds 3600
Restart=on-failure
RestartSec=30
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/srv/drewcraft

[Install]
WantedBy=multi-user.target
